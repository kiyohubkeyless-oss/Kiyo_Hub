local function isMM2()
    return game.PlaceId == 142823291 or workspace:FindFirstChild("GunDrop") ~= nil or LocalPlayer.Backpack:FindFirstChild("Revolver") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Revolver"))
end

local function getClosestPlayerToHead()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myHrp = myChar.HumanoidRootPart
    
    local successMM2, isSheriffOrHero = pcall(function()
        return isMM2() and (myChar:FindFirstChild("Revolver") or LocalPlayer.Backpack:FindFirstChild("Revolver"))
    end)
    if not successMM2 then isSheriffOrHero = false end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            
            if hum and hum.Health > 0 and head then
                local isValid = true
                if isSheriffOrHero then
                    local hasKnife = p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")
                    if not hasKnife then isValid = false end
                else
                    if p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team and p.Team.Name ~= "Neutral" then
                        isValid = false
                    end
                end
                
                if isValid then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = {myChar, p.Character}
                    rayParams.IgnoreWater = true
                    
                    local origin = Camera.CFrame.Position
                    local direction = head.Position - origin
                    local rayResult = workspace:Raycast(origin, direction, rayParams)
                    
                    if not rayResult then
                        local dist = (head.Position - myHrp.Position).Magnitude
                        if dist < shortestDistance then 
                            shortestDistance = dist 
                            closestPlayer = p 
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

